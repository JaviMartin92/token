# Alpha Centauri Sandbox Configuration

# Blockchain Connection (Arbitrum One Mainnet Fork)
# Note: A private endpoint (Alchemy/Infura) is highly recommended to avoid rate limits
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_FORK_BLOCK=230000000

# Database Persistence
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/alpha_centauri?schema=public

# Redis Broker Configuration
REDIS_URL=redis://localhost:6379

# Sandbox Smart Contract Deployment Addresses (Filled after script deployment)
TREASURY_ADDRESS=
CIRCUIT_BREAKER_ADDRESS=
ATOMIC_SWAP_ADDRESS=
YIELD_VAULT_ADDRESS=

# Operational configuration. Private keys are supplied only by the deployment runtime,
# never by frontend VITE_* variables or committed configuration files.
BACKEND_OPERATOR_PRIVATE_KEY=
GOVERNANCE_MULTISIG_ADDRESS=
