# Alpha Centauri Sandbox Configuration

# Blockchain Connection (Arbitrum One Mainnet Fork)
# Note: A private endpoint (Alchemy/Infura) is highly recommended to avoid rate limits
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_FORK_BLOCK=230000000

# Database Persistence
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/alpha_centauri?schema=public

# Redis Broker Configuration
REDIS_URL=redis://localhost:6379

# Sandbox Smart Contract Deployment Addresses (Filled after script deployment)
TREASURY_ADDRESS=
CIRCUIT_BREAKER_ADDRESS=
ATOMIC_SWAP_ADDRESS=
YIELD_VAULT_ADDRESS=
CORP_CONTRIBUTION_ADDRESS=

# Operational Wallets & Private Keys
# Standard Anvil Private Keys can be used in local dev
BACKEND_OPERATOR_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
GOVERNANCE_MULTISIG_ADDRESS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
